# === LLM Configuration ===

# OpenRouter (Free models available)
# Get API key: https://openrouter.ai/keys
LLM_PROVIDER=custom
LLM_MODEL=openrouter/google/gemma-4-26b-a4b-it:free
LLM_ENDPOINT=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_key_here

# Embeddings use Google Gemini (separate free quota, 1500 req/min)
# Get API key: https://aistudio.google.com/apikey
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_API_KEY=your_gemini_api_key_here
EMBEDDING_DIMENSIONS=768

# Option 3: Ollama (Fully local, free, runs on your machine)
# LLM_PROVIDER=ollama
# LLM_MODEL=ollama/llama3.2
# LLM_ENDPOINT=http://localhost:11434
# LLM_API_KEY=ollama
#
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=ollama/nomic-embed-text
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_ENDPOINT=http://localhost:11434

# === Speed Optimizations ===
COGNEE_SKIP_CONNECTION_TEST=true
COGNEE_LOG_LEVEL=ERROR

# === Rate Limiting (Free tier safe defaults) ===
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_REQUESTS=13
LLM_RATE_LIMIT_INTERVAL=60
EMBEDDING_RATE_LIMIT_ENABLED=true
EMBEDDING_RATE_LIMIT_REQUESTS=1350
EMBEDDING_RATE_LIMIT_INTERVAL=60
